# Godot
.godot/
*.import
export.cfg
export_presets.cfg
build/
dist/
*.translation

# Local-only character data: the real characters.json can live here without
# touching the committed placeholder. The loader prefers this file.
data/characters.local.json

# Test / tool output
tests/output/
*.log

# Local image-search cache (external, copyrighted references - never committed)
image-search/

# Raw generated state frames (one file is ~1 MB). The normalised frames that the
# game ships are written next to them and are committed; the originals are not.
assets/characters/states/*/_source/
